# Bali First Timer — example environment variables
# Copy this file to `.env.local` and replace values as needed.
# Variables prefixed with `NEXT_PUBLIC_` are visible in the browser; do not store secrets in them.

# Canonical production origin. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://balifirsttimer.com

# Contact details. Use the country code and digits only for *_NUMBER values.
NEXT_PUBLIC_PHONE_NUMBER=6281283808333
NEXT_PUBLIC_WHATSAPP_NUMBER=6281283808333
NEXT_PUBLIC_PHONE_DISPLAY=+62 812-8380-8333
NEXT_PUBLIC_BUSINESS_LOCATION=Bali, Indonesia

# Search-engine site-verification tokens. Paste only the token, not the full meta tag.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Leave empty when GA4 is installed through GTM to avoid duplicate events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID, for example GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=

# Yandex Metrica counter number, for example 12345678.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Use `true` to enable Session Replay / Webvisor. Confirm consent requirements first.
NEXT_PUBLIC_YANDEX_WEBVISOR=false

# Meta Pixel ID, for example 123456789012345.
NEXT_PUBLIC_META_PIXEL_ID=
